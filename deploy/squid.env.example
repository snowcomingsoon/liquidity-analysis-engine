# Copy to deploy/squid.env on the server (never in git) and fill in.
# Only read by the squid profile: docker compose --profile squid up -d

# Postgres of the squid (own database, own volume squid-db)
POSTGRES_DB=squid
POSTGRES_PASSWORD=
DB_HOST=squid-db
DB_PORT=5432
DB_NAME=squid
DB_USER=postgres
DB_PASS=
GQL_PORT=4350

# Ethereum Uniswap V3 pools (comma-separated), checked against the factory at start
POOLS=
# First block read (the pilot reads from here, never the whole history by default)
START_BLOCK=
# Ethereum JSON-RPC (required)
RPC_ETH_HTTP=
# PORTAL_URL=https://portal.sqd.dev/datasets/ethereum-mainnet
