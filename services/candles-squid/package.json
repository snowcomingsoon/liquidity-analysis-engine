{
  "name": "candles-squid",
  "private": true,
  "description": "Uniswap V3 (Ethereum) candles for an allowlist of pools, from Swap events. Based on subsquid-labs/uniswapv3-squid (MIT), see PROVENANCE.md.",
  "scripts": {
    "build": "rm -rf lib && tsc",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf lib && tsc && node --test lib/test/*.test.js",
    "codegen": "squid-typeorm-codegen",
    "migration:apply": "squid-typeorm-migration apply",
    "process": "node lib/main.js",
    "serve": "squid-graphql-server"
  },
  "dependencies": {
    "@subsquid/batch-processor": "1.1.0",
    "@subsquid/evm-abi": "1.0.0",
    "@subsquid/evm-codec": "1.0.0",
    "@subsquid/evm-objects": "0.0.3",
    "@subsquid/evm-stream": "0.1.3",
    "@subsquid/graphql-server": "4.12.1",
    "@subsquid/rpc-client": "4.16.0",
    "@subsquid/squid-sdk": "0.6.0",
    "@subsquid/typeorm-migration": "1.4.0",
    "@subsquid/typeorm-store": "1.9.2",
    "pg": "^8.12.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@subsquid/typeorm-codegen": "2.4.0",
    "@types/node": "^22.5.3",
    "typescript": "~5.5.4"
  }
}
