# Postgres (the squid's own database, not the app's)
DB_HOST=squid-db
DB_PORT=5432
DB_NAME=squid
DB_USER=postgres
DB_PASS=change-me
GQL_PORT=4350

# Pools to index (comma-separated, Ethereum Uniswap V3 only, checked against the factory)
POOLS=
# First block read. Required: no full-history sync by default.
START_BLOCK=
# Ethereum JSON-RPC: factory/token reads, slot0 at START_BLOCK - 1, fallback source
RPC_ETH_HTTP=
# Portal dataset; the public one needs no key
# PORTAL_URL=https://portal.sqd.dev/datasets/ethereum-mainnet
# PORTAL_API_KEY=
# ETH_USD_POOL=0x88e6a0c2ddd26feeb64f039a2c41296fcb3f5640
# FINALITY_BLOCKS=64
